#!/usr/bin/python3
"""RimFrost welcome: a short guide after the first login.

  rimfrost-welcome              open the guide
  rimfrost-welcome --first-run  open it only if it has not been finished yet
  rimfrost-welcome --games      print the anti-cheat status of installed Steam games
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

HERE = "/usr/share/rimfrost/welcome"
DONE = os.path.expanduser("~/.config/rimfrost/welcome-done")
AWACY_BUNDLED = os.path.join(HERE, "awacy.json")
AWACY_CACHE = os.path.expanduser("~/.cache/rimfrost/awacy.json")
AWACY_URL = "https://raw.githubusercontent.com/AreWeAntiCheatYet/AreWeAntiCheatYet/HEAD/games.json"
MARK = "/usr/share/plasma/look-and-feel/org.rimfrost.splash/contents/splash/images/rimfrost-mark.svg"
GAMEMODE_STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "rimfrost-gamemode.json")
GAMEMODE_CONF = os.path.expanduser("~/.config/rimfrost/gamemode.json")
KGLOBAL = os.path.expanduser("~/.config/kglobalshortcutsrc")

WORKS = {"Supported": "Works", "Running": "Works"}
NOT_ONLINE = {"Broken": "Online play unsupported", "Denied": "Online play unsupported",
              "Planned": "Support coming"}


# --- anti-cheat data ----------------------------------------------------------------

def awacy():
    """The Are We Anti-Cheat Yet list: a weekly refreshed copy, else the one in the image."""
    try:
        fresh = time.time() - os.path.getmtime(AWACY_CACHE) < 7 * 86400
    except OSError:
        fresh = False
    if not fresh:
        try:
            with urllib.request.urlopen(AWACY_URL, timeout=5) as r:
                data = r.read()
            json.loads(data)
            os.makedirs(os.path.dirname(AWACY_CACHE), exist_ok=True)
            with open(AWACY_CACHE, "wb") as f:
                f.write(data)
        except Exception:
            pass
    for path in (AWACY_CACHE, AWACY_BUNDLED):
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            continue
    return []


def norm(name):
    return re.sub(r"[^a-z0-9]", "", (name or "").lower())


def steam_libraries():
    roots = [os.path.expanduser(p) for p in ("~/.local/share/Steam", "~/.steam/steam",
                                             "~/.var/app/com.valvesoftware.Steam/.local/share/Steam")]
    libs = []
    for root in roots:
        vdf = os.path.join(root, "steamapps", "libraryfolders.vdf")
        try:
            with open(vdf, encoding="utf-8", errors="replace") as f:
                libs += re.findall(r'"path"\s+"([^"]+)"', f.read())
        except OSError:
            pass
        libs.append(root)
    seen, out = set(), []
    for lib in libs:
        real = os.path.realpath(lib)
        if real not in seen and os.path.isdir(os.path.join(real, "steamapps")):
            seen.add(real)
            out.append(real)
    return out


def installed_games():
    games = {}
    for lib in steam_libraries():
        for acf in glob.glob(os.path.join(lib, "steamapps", "appmanifest_*.acf")):
            try:
                with open(acf, encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            appid = re.search(r'"appid"\s+"(\d+)"', text)
            name = re.search(r'"name"\s+"([^"]+)"', text)
            if appid and name and not re.search(r"proton|steam linux runtime|steamworks", name.group(1), re.I):
                games[appid.group(1)] = name.group(1)
    return games


def library_status():
    """Installed Steam games with a known anti-cheat status, problems first."""
    db = awacy()
    by_id = {str(g.get("storeIds", {}).get("steam")): g for g in db if g.get("storeIds", {}).get("steam")}
    by_name = {norm(g.get("name")): g for g in db}
    out = []
    for appid, name in installed_games().items():
        g = by_id.get(appid) or by_name.get(norm(name))
        if not g:
            continue
        st = g.get("status")
        if st in WORKS:
            out.append({"name": name, "status": WORKS[st], "ok": True})
        elif st in NOT_ONLINE:
            out.append({"name": name, "status": NOT_ONLINE[st], "ok": False})
    out.sort(key=lambda g: (g["ok"], g["name"].lower()))
    return out, len(installed_games())


# --- the window -----------------------------------------------------------------------

def run_window():
    from PySide6.QtCore import Property, QObject, QTimer, QUrl, Signal, Slot
    from PySide6.QtGui import QDesktopServices, QGuiApplication, QIcon
    from PySide6.QtQml import QQmlApplicationEngine

    class Backend(QObject):
        changed = Signal()

        def __init__(self):
            super().__init__()
            self._games, self._installed = [], 0
            self._state = {}
            self.scanLibrary()
            self.poll()
            self.t = QTimer(self)
            self.t.timeout.connect(self.poll)
            self.t.start(1500)

        def poll(self):
            try:
                with open(GAMEMODE_STATE) as f:
                    st = json.load(f)
            except (OSError, ValueError):
                st = {}
            if st != self._state:
                self._state = st
                self.changed.emit()

        # game mode
        def _gm(self):
            try:
                with open(GAMEMODE_CONF) as f:
                    return bool(json.load(f).get("enabled", True))
            except (OSError, ValueError):
                return True

        def _set_gm(self, on):
            subprocess.run(["rimfrost-gamemode", "on" if on else "off"], capture_output=True)
            self.changed.emit()

        gameMode = Property(bool, _gm, _set_gm, notify=changed)

        @Property(str, notify=changed)
        def gameModeStatus(self):
            if not self._state:
                return "Game mode starts with your desktop."
            if not self._gm():
                return "Off. Games get the same share as everything else."
            games = self._state.get("games") or {}
            if games:
                g = next(iter(games.values()))
                return f"Active: {g.get('caption') or 'a game'} has priority right now."
            return "Waiting for a game. It switches on by itself when you play."

        # ClipFrost
        @Property(bool, constant=True)
        def hasClipFrost(self):
            return shutil.which("clipfrost-settings") is not None

        @Property(str, constant=True)
        def clipHotkey(self):
            try:
                inside = False
                for line in open(KGLOBAL).read().splitlines():
                    if line.startswith("["):
                        inside = line.strip() == "[services][clipfrost-save.desktop]"
                    elif inside and line.startswith("_launch="):
                        key = line.split("=", 1)[1].split(",")[0].strip()
                        if key:
                            return key
            except OSError:
                pass
            return "Alt+F10"

        @Slot()
        def openClipFrost(self):
            subprocess.Popen(["clipfrost-settings"], start_new_session=True)

        # Steam and links
        @Slot()
        def openSteam(self):
            subprocess.Popen(["steam"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        @Slot(str)
        def openUrl(self, url):
            QDesktopServices.openUrl(QUrl(url))

        @Property(bool, constant=True)
        def hasPortal(self):
            return shutil.which("yafti_gtk.py") is not None and os.path.exists("/usr/share/yafti/yafti.yml")

        @Slot()
        def openPortal(self):
            subprocess.Popen(["yafti_gtk.py", "/usr/share/yafti/yafti.yml"], start_new_session=True)

        # library
        @Slot()
        def scanLibrary(self):
            self._games, self._installed = library_status()
            self.changed.emit()

        @Property("QVariantList", notify=changed)
        def games(self):
            return self._games

        @Property(str, notify=changed)
        def libraryIntro(self):
            bad = sum(1 for g in self._games if not g["ok"])
            if self._installed == 0:
                return ("When you have installed games in Steam, this page shows which ones use anti-cheat "
                        "and whether their online play works here. Most games have no anti-cheat and simply work.")
            if bad == 0:
                return (f"Good news: none of your {self._installed} installed games has an anti-cheat problem. "
                        "The games listed below use anti-cheat that works on RimFrost OS.")
            return (f"{bad} of your {self._installed} installed games use anti-cheat that is unsupported here, so "
                    "their online play won't work. Single-player often still does. Everything else is fine.")

        @Property(int, constant=True)
        def startPage(self):
            for a in sys.argv:
                if a.startswith("--page="):
                    return int(a.split("=", 1)[1])
            return 0

        @Property(str, constant=True)
        def markPath(self):
            return MARK

        @Slot()
        def finish(self):
            os.makedirs(os.path.dirname(DONE), exist_ok=True)
            with open(DONE, "w") as f:
                f.write(time.strftime("%Y-%m-%d %H:%M:%S\n"))

    app = QGuiApplication(sys.argv)
    app.setApplicationName("RimFrost Welcome")
    app.setDesktopFileName("rimfrost-welcome")
    app.setWindowIcon(QIcon.fromTheme("rimfrost-logo"))
    engine = QQmlApplicationEngine()
    backend = Backend()
    engine.rootContext().setContextProperty("backend", backend)
    engine.load(QUrl.fromLocalFile(os.path.join(HERE, "welcome.qml")))
    if not engine.rootObjects():
        return 1
    return app.exec()


def main(argv):
    if "--games" in argv:
        games, n = library_status()
        print(f"{n} installed Steam games")
        for g in games:
            print(f"  {'OK ' if g['ok'] else '!! '} {g['name']}: {g['status']}")
        return 0
    if "--first-run" in argv and os.path.exists(DONE):
        return 0
    return run_window()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
