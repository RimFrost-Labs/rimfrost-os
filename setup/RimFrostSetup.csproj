<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimFrost Setup: installs RimFrost OS from Windows without a USB stick.
       .NET Framework 4.8 ships with every Windows 10 and 11, so the exe runs
       without installing anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- 64-bit, so System32 tools like bcdedit aren't redirected to SysWOW64 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <AssemblyName>RimFrostSetup</AssemblyName>
    <RootNamespace>RimFrostSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>rimfrost.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <Product>RimFrost Setup</Product>
    <Company>RimFrost Labs</Company>
    <Copyright>RimFrost Labs</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="..\cosign.pub" LogicalName="cosign.pub" />
    <Resource Include="rimfrost.ico" />
  </ItemGroup>

</Project>
