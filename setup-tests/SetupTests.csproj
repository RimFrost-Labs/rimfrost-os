<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks for RimFrost Setup's logic that don't need admin rights or a real disk:
       dotnet run -c Release (then the ISO and its .sig as arguments) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Compile Include="..\setup\Downloader.cs" Link="Downloader.cs" />
    <Compile Include="..\setup\Log.cs" Link="Log.cs" />
    <Compile Include="..\setup\SystemCheck.cs" Link="SystemCheck.cs" />
    <Compile Include="..\setup\Shell.cs" Link="Shell.cs" />
    <EmbeddedResource Include="..\cosign.pub" LogicalName="cosign.pub" />
  </ItemGroup>

</Project>
